GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_LIVE_MODEL=gemini-live-2.5-flash-native-audio
# Optional Gemini Developer API connection for synthetic tests; server-side only.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Omit this setting if using gcloud Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=C:/private/path/service-account.json
ALAAP_TURN_USERNAME=
ALAAP_TURN_CREDENTIAL=
# Automatic telephone registration after operator sign-in. Server-side, never committed.
ALAAP_ACCESS_TOKEN=
ALAAP_SIP_EXTENSION=
ALAAP_SIP_DOMAIN=
ALAAP_SIP_PASSWORD=
SUPABASE_URL=https://YOUR_DEDICATED_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Two different random 32-byte hexadecimal keys; back up privately before storing profiles.
PROFILE_ENCRYPTION_KEY=
PHONE_LOOKUP_KEY=
GEMINI_EXTRACT_MODEL=gemini-2.5-flash
# Optional absolute Python path; defaults to the root .research-venv environment.
RESEARCH_PYTHON=
